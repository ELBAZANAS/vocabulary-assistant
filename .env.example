# Copy this file to .env and paste your own keys.
# Leave a line blank if you do not use that provider.
# Restart `npm run dev` after you save .env.
# Never commit .env. It is listed in .gitignore.

# Google Gemini — https://aistudio.google.com/apikey
# Used for lookups, quizzes, the tutor, and stories.
GEMINI_API_KEY=

# Alibaba Qwen (DashScope) — https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# Groq — https://console.groq.com/keys
# An xAI key also works here if it starts with xai-
GROQ_API_KEY=

# Tavily — https://tavily.com
# Optional. Adds live web snippets when building example sentences.
TAVILY_API_KEY=

# Local server port
PORT=3000
